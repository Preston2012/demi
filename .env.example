# Demiurge configuration.
#
#   cp .env.example .env
#
# docker-compose reads this file via env_file, so .env must exist before
# `docker compose up`. Everything below is either required or has a working
# default. Container paths and ports (DB_PATH, BACKUP_PATH, PORT, HOST) are set
# by docker-compose.yml and do not belong here.


# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Bearer token for the REST and MCP surface. Every request must present it.
#   openssl rand -hex 32
DEMIURGE_API_KEY=

# Encryption-at-rest key for the SQLCipher database. Required in production.
# Losing this key means losing the database: there is no recovery path.
# Back it up somewhere that is not the server.
#   openssl rand -hex 32
DEMIURGE_DB_KEY=

# Answer and judge model (GPT-4.1-mini, GPT-4o-mini).
OPENAI_API_KEY=


# ---------------------------------------------------------------------------
# Trust-branching consensus
# ---------------------------------------------------------------------------
# Contested claims are adjudicated by more than one provider so that a single
# model cannot decide what becomes memory on its own. The default expects
# OpenAI plus Anthropic plus Google. Set the two below to run the default, or
# leave them empty to fall back to single-provider adjudication.

ANTHROPIC_API_KEY=
GOOGLE_API_KEY=


# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Separate token for administrative endpoints. Leave empty to disable them.
DEMIURGE_ADMIN_TOKEN=

# error | warn | info | debug
LOG_LEVEL=info

# Encrypted vault for secrets held as memories, with extraction and injection
# detection on read.
VAULT_ENABLED=true

# Local request telemetry, written to the data volume. Never leaves the host.
TELEMETRY_ENABLED=false
